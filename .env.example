# Optioneel. Alles hieronder kan ook in de webUI (Beheer › Instellingen) worden
# ingevuld; een waarde in de webUI heeft voorrang.

# Claude, voor de samenvattingen in de weekmail.
ANTHROPIC_API_KEY=

# De Whisper-worker voor audio en video (transcriptie, stemmen, namen), via
# Tailscale bereikbaar, bijvoorbeeld http://naam-of-ip:8765. Het token is
# hetzelfde als WORKER_TOKEN van de Plaud Whisper Worker.
WORKER_URL=
WORKER_TOKEN=

# Optioneel: ransomware.live Pro, voor alle Nederlandse ransomwareslachtoffers
# (zonder sleutel alleen de nieuwste van ransomlook.io).
RANSOMWARE_LIVE_API_KEY=

# Optioneel: NS-storingen en werkzaamheden (gratis sleutel via apiportal.ns.nl,
# abonneren op de Reisinformatie API). Zonder sleutel staat die bron uit.
NS_API_KEY=

# Optioneel: de Telegram-bot voor tipgevers (token van @BotFather). Kan ook bij
# Beheer › Telegram worden ingevuld.
TELEGRAM_BOT_TOKEN=
