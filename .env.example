# Optioneel. Alles hieronder kan ook in de webUI (Beheer › Instellingen) worden
# ingevuld; een waarde in de webUI heeft voorrang.

# Claude, voor de samenvattingen in de weekmail.
ANTHROPIC_API_KEY=

# De Whisper-worker voor audio en video (transcriptie, stemmen, namen), via
# Tailscale bereikbaar, bijvoorbeeld http://naam-of-ip:8765. Het token is
# hetzelfde als WORKER_TOKEN van de Plaud Whisper Worker.
WORKER_URL=
WORKER_TOKEN=
